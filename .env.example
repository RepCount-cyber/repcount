# Random string of 32+ characters used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Postgres connection string. Use Neon's pooled connection string (host contains "-pooler") in production.
DATABASE_URL=

# First super admin, created on startup if no user has this email. They sign in with Google,
# or with ADMIN_PASSWORD (10+ characters) if set. Remove ADMIN_PASSWORD once they have signed in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# "true" seeds the sample cohort and the public demo logins into an EMPTY database.
# Never enable it on a database that will hold real clients: the demo passwords are public.
SEED_DEMO_DATA=false

# Set to "true" to list the demo accounts on the login page in a production build.
SHOW_DEMO_ACCOUNTS=false

# Public URL of the deployed site (used for social-share image links and the Google redirect URI).
SITE_URL=http://localhost:3000

# Optional: Google sign-in (Google Cloud Console → Credentials → OAuth client ID, Web application).
# Redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tests only: a throwaway Postgres database whose name contains "test". npm test wipes it.
TEST_DATABASE_URL=

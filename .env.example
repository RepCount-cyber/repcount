# Random string of 32+ characters used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Public URL of the deployed site (used for social-share image links).
SITE_URL=http://localhost:3000

# Set to "true" to list the demo accounts on the login page in a production build.
SHOW_DEMO_ACCOUNTS=false

# Optional: where the SQLite database file lives (default data/repcount.db).
DATABASE_PATH=

# Optional: Google sign-in (Google Cloud Console → Credentials → OAuth client ID, Web application).
# Redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
